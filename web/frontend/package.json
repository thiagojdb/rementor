    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@tailwindcss/postcss": "^4.3.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  }
